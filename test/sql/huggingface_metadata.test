# name: test/sql/huggingface_metadata.test
# description: test catalog metadata for Hugging Face functions
# group: [sql]

require huggingface

query I
SELECT count(*)
FROM duckdb_functions()
WHERE function_name IN (
    'hf_dataset_estimate',
    'hf_files',
    'hf_profile',
    'hf_scan',
    'huggingface_internal_blob_size'
)
AND description IS NOT NULL
AND length(examples) > 0
AND length(categories) > 0
AND parameters[1] IN ('repository', 'url');
----
5

query I
SELECT count(*)
FROM duckdb_functions()
WHERE (function_name = 'hf_scan' AND list_sort(parameters) =
       list_sort(['repository', 'revision', 'config', 'split', 'path', 'union_by_name', 'filename']))
   OR (function_name = 'hf_profile' AND list_sort(parameters) =
       list_sort(['repository', 'revision', 'config', 'split', 'path']))
   OR (function_name = 'hf_files' AND list_sort(parameters) =
       list_sort(['repository', 'revision', 'config', 'split', 'path', 'blob_column', 'blob_concurrency']))
   OR (function_name = 'hf_dataset_estimate' AND list_sort(parameters) =
       list_sort(['repository', 'revision', 'config', 'split', 'path', 'blob_column', 'blob_hash_column',
                  'row_sample_size', 'blob_concurrency']));
----
4
