# name: test/sql/huggingface.test
# description: test Hugging Face extension
# group: [sql]

require parquet

require huggingface

statement ok
SET cache_httpfs_cache_directory = '__TEST_DIR__/cache';

query I
SELECT cache_httpfs_clear_cache();
----
true

query T
SELECT current_setting('cache_httpfs_type');
----
in_mem

query T
SELECT "data cache" FROM cache_httpfs_get_cache_type();
----
in_mem

query I
SELECT cache_httpfs_get_ondisk_data_cache_size();
----
0

statement error
SELECT * FROM hf_files('invalid-repository-name');
----
Invalid Input Error: Hugging Face repository must use the 'owner/name' form

query I
SELECT
    parquet_file_count = 1
    AND sampled_row_count = 100
    AND parquet_size_bytes > 0
    AND logical_blob_count > 0
    AND estimated_physical_blob_count > 0
    AND estimated_blob_dup_rate BETWEEN 0 AND 1
    AND (average_blob_size_bytes IS NULL OR average_blob_size_bytes > 0)
    AND (estimated_blob_size_bytes IS NULL OR estimated_blob_size_bytes > 0)
    AND (estimated_dataset_size_bytes IS NULL OR estimated_dataset_size_bytes > parquet_size_bytes)
FROM hf_dataset_estimate(
    'mlfoundations/MINT-1T-HTML',
    path = 'data-v1.1/partial-train/0001.parquet',
    blob_column = 'images',
    blob_hash_column = 'image_hashes',
    row_sample_size = 100,
    blob_concurrency = 14
);
----
true

query I
SELECT count(*) > 0
FROM hf_files('ibm/duorc', config = 'ParaphraseRC', split = 'train');
----
true

query I
SELECT count(*) > 0 AND sum(parquet_size_bytes) > 0
FROM hf_files('ibm/duorc', config = 'ParaphraseRC', split = 'train');
----
true

query I
SELECT count(*) = 1
FROM (
    SELECT *
    FROM hf_scan('ibm/duorc', config = 'ParaphraseRC', split = 'train')
    LIMIT 1
);
----
true

query I
SELECT file_count > 0 AND total_rows > 0
FROM hf_profile('ibm/duorc', config = 'ParaphraseRC', split = 'train');
----
true

query I
SELECT cache_httpfs_get_ondisk_data_cache_size();
----
0
